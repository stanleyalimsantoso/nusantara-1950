rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per room holds the whole game. Any signed-in player can read and play it.
    match /games/{room} {
      allow read, write: if request.auth != null;
    }
    // Each player's private notes (the rebel hideout). Only that player can read or write them.
    match /data/users/{uid}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
